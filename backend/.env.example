# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (shared team cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartLabGuardian?retryWrites=true&w=majority

# JWT settings for staff (admin / lecturer / examiner) dashboard logins
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Shared secret used by the monitoring agent installed on lab PCs
AGENT_API_KEY=change-this-agent-key

# Comma separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Default password given to students created through Excel import
DEFAULT_STUDENT_PASSWORD=Student@123
