PORT=5000
# Local MongoDB (MongoDB Community Server / Compass default). Database name: smartlab
MONGO_URI=mongodb://127.0.0.1:27017/smartlab
# Secret shared with the client agent (client-agent/config.json "agent_key" must match)
AGENT_KEY=change-this-secret
# Frontend origin allowed by CORS (Vite default)
CLIENT_ORIGIN=http://localhost:5173
